<?xml version="1.0" encoding="UTF-8"?>
<plist version="1.0">
  <dict>
    <key>name</key>
    <string>Auto Closing for Piranha</string>
    <key>scope</key>
    <string>source.piranha</string>
    <key>settings</key>
    <dict>
      <key>autoMatchEnabled</key>
      <true/>
      <key>autoCloseBrackets</key>
      <array>
        <string>()</string>
        <string>{}</string>
        <string>""</string>
        <string>/* */</string>
      </array>
      <key>smartTypingPairs</key>
      <array>
        <string>(, )</string>
        <string>{, }</string>
        <string>["</string>
        <string>/*, */</string>
      </array>
    </dict>
  </dict>
</plist>
